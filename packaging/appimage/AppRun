#!/bin/sh
# What the AppImage runs. Starts the translator with the Bun and the engines packed beside this
# file, or downloads the models (`fetch`). The models and the voices are not in the AppImage; they
# live in the user's data directory unless MODELS_DIR and VOICES_DIR (or the flags) say otherwise.
set -eu

here=$(dirname "$(readlink -f "$0")")
app=$here/usr/share/index-translator
bun=$here/usr/bin/bun
# The name to print in instructions: the AppImage file, or this script in an unpacked AppImage.
self=${APPIMAGE:-$0}

data=${XDG_DATA_HOME:-$HOME/.local/share}/index-translator
export MODELS_DIR="${MODELS_DIR:-$data/models}"
export VOICES_DIR="${VOICES_DIR:-$data/voices}"
export INDEX_TRANSLATOR_APPIMAGE="$self"

# The NVIDIA variant has CUDA as its one GPU backend (scripts/build_appimage.ts --cuda), the other Vulkan.
if [ -e "$app/vendor/llama.cpp/libggml-cuda.so" ]; then
  export SPEECH_BACKEND="${SPEECH_BACKEND:-cuda}"
  gpu_needed="An NVIDIA GPU with a driver for CUDA 13 (version 580 or newer) is needed."
  cuda_notice=", NVIDIA's CUDA runtime libraries (cudart, cuBLAS and cuFFT, under the CUDA Toolkit EULA)"
else
  gpu_needed="A GPU with a Vulkan driver is needed."
  cuda_notice=""
fi

case "${1:-}" in
  fetch)
    shift
    exec "$bun" --config="$app/bunfig.toml" --disallow-code-generation-from-strings=strict "$app/scripts/fetch_models.ts" "$@"
    ;;
  notices | licenses)
    cat "$app/THIRD_PARTY_NOTICES.md"
    exit 0
    ;;
  -V | --version | version)
    cat "$app/VERSION"
    exit 0
    ;;
  -h | --help | help)
    cat <<EOF
Index Translator: a local text translator that runs on your GPU.

Usage:
  $self [--setting value ...]   start the translator and open it in the browser
  $self fetch [--model id ...]  download the models and the example voices (about 19.2 GiB)
  $self notices                 print the third-party notices (licenses of what is bundled)
  $self --version

fetch downloads everything unless --model names what to get: index-translate-9b,
index-nailong-9b, index-tts-2.5 (reading aloud, with the voices), bs-roformer (takes the voice out
of music and noise in an uploaded sample), sat-3l-sm (finds sentences for reading aloud), labse (matches the sentences of a source and its
translation). It needs curl, and continues an interrupted download when run again.

Settings are flags or environment variables (--port 8080 or PORT=8080). The common ones:
  --port 3000            port to listen on
  --models-dir DIR       where the models are (default: $data/models)
  --voices-dir DIR       where the voices are (default: $data/voices)
  --gpu-layers all       0 runs on the processor, without a GPU
  --speech 0             turn reading aloud off
  --open-browser 0       do not open the browser
$gpu_needed The README lists every setting.
EOF
    exit 0
    ;;
esac

cat >&2 <<EOF
Index Translator bundles third-party software: llama.cpp and ggml (MIT, with stb_image, miniaudio
and xxHash), audio.cpp (Apache-2.0,
with cJSON, SentencePiece and Abseil, and Silero VAD's weights under MIT), libsoxr (LGPL-2.1 or later)$cuda_notice, minicelt (BSD-3-Clause, from libopus), turndown (MIT), ONNX Runtime (MIT, with the notices of its own components in ThirdPartyNotices.txt), Bun (MIT, with JavaScriptCore under the LGPL and other
components) and, in the browser, pdf-inspector (MIT) and pdf.js (Apache-2.0, with fonts and
decoders under their own licenses) for PDF files, undoc (MIT) for Word files and the QOA codec (public domain) for speech. Models are not bundled; \`fetch\` shows their licenses before it downloads them.
Full notices: $self notices
EOF
exec "$bun" --config="$app/bunfig.toml" --disallow-code-generation-from-strings=strict "$app/src/server.ts" "$@"
