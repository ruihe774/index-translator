{
  "name": "index-translator",
  "private": true,
  "license": "Unlicense",
  "type": "module",
  "scripts": {
    "dev": "OPEN_BROWSER=0 DEV_RELOAD=1 bun --watch src/server.ts",
    "test": "bun test",
    "typecheck": "bun check -p tsconfig.json && bun check -p public/tsconfig.json && bun check -p e2e/tsconfig.json",
    "e2e": "playwright test",
    "lint:css": "bun scripts/lint_css.ts",
    "lint:ts": "bun lint",
    "format:write": "bun format",
    "format:check": "bun format --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13",
    "@playwright/test": "~1.64",
    "@types/bun": "^1.4",
    "browserslist": "^4.29",
    "doiuse": "^6.0",
    "postcss": "^8.5"
  }
}
