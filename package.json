{
  "name": "index-translator",
  "private": true,
  "license": "Unlicense",
  "type": "module",
  "scripts": {
    "dev": "OPEN_BROWSER=0 DEV_RELOAD=1 ALLOWED_WEBPAGE_DOMAINS='*' bun --watch src/server.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage/unit",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:coverage": "E2E_COVERAGE=1 playwright test -c e2e/playwright.config.ts",
    "lint:css": "bun scripts/lint_css.ts",
    "lint:es": "bun scripts/lint_es.ts",
    "lint:ts": "bun lint -f agent",
    "format:write": "bun fmt",
    "format:check": "bun fmt --check",
    "gen:api": "openapi-typescript docs/openapi.yaml -o src/api-schema.d.ts --root-types --root-types-no-schema-prefix --default-non-nullable false"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13",
    "@mdn/browser-compat-data": "^8.1",
    "@playwright/test": "~1.64",
    "@types/bun": "^1.4",
    "browserslist": "^4.29",
    "doiuse": "^6.0",
    "eslint": "^10.6",
    "eslint-plugin-browser-compat": "^0.1",
    "eslint-plugin-es-x": "^10.1",
    "monocart-coverage-reports": "^2.13",
    "network-information-types": "^0.1",
    "openapi-typescript": "^7.13",
    "postcss": "^8.5",
    "stylelint": "^17.16",
    "stylelint-config-recommended": "^18.0"
  }
}
