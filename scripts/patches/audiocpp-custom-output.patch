@@ -249,6 +250,8 @@ struct audiocpp_request {
 
 struct audiocpp_result {
     rt::TaskResult result;
+    /* custom_schema_output's data as JSON text, made by audiocpp_result_custom_output. */
+    mutable std::string custom_json;
     /* An event exposes its contents through a result view that it owns. The
      * view has the same type as an owned result and there is a public free for
      * that type, so freeing one has to be a no-op rather than a double free. */
@@ -960,6 +963,23 @@ audiocpp_status audiocpp_result_audio(const audiocpp_result * result,
     return AUDIOCPP_OK;
 }
 
+audiocpp_status audiocpp_result_custom_output(const audiocpp_result * result,
+                                              const char ** out_schema,
+                                              const char ** out_json) {
+    if (result == nullptr) {
+        return fail(AUDIOCPP_ERR_INVALID_ARGUMENT, "result must be non-null");
+    }
+    if (!result->result.custom_schema_output.has_value()) {
+        return fail(AUDIOCPP_ERR_NOT_AVAILABLE, "result carries no custom output");
+    }
+    return guard([&] {
+        result->custom_json = engine::io::json::stringify(result->result.custom_schema_output->data);
+        assign_out(out_schema, result->result.custom_schema_output->schema);
+        assign_out(out_json, result->custom_json);
+        return AUDIOCPP_OK;
+    });
+}
