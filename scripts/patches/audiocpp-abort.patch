+/* Added by index-translator (scripts/patches/audiocpp-abort.patch); not part of
+ * audio.cpp's C API.
+ *
+ * Names a flag that stops a running task. While `*flag` is non-zero, a run of a
+ * family that checks it (index_tts2: before every decoding step, every
+ * diffusion step and the vocoder) fails with AUDIOCPP_ERR_RUNTIME and the
+ * detail "aborted"; the session stays usable. The flag is read without a lock,
+ * so another thread may set it while this one is inside audiocpp_session_run.
+ * It must stay valid until it is replaced; NULL (the default) means no flag.
+ * One flag per process. */
+AUDIOCPP_API void audiocpp_set_abort_flag(const volatile int32_t * flag);
+
 /* Human-readable name for a status code. Borrowed, static lifetime. */
 AUDIOCPP_API const char * audiocpp_status_string(audiocpp_status status);
 
diff --git a/include/engine/framework/runtime/abort.h b/include/engine/framework/runtime/abort.h
new file mode 100644
index 0000000..bdf1631
--- /dev/null
+++ b/include/engine/framework/runtime/abort.h
@@ -0,0 +1,28 @@
+#ifndef ENGINE_FRAMEWORK_RUNTIME_ABORT_H
+#define ENGINE_FRAMEWORK_RUNTIME_ABORT_H
+
+// Added by index-translator (scripts/patches/audiocpp-abort.patch); not part of audio.cpp.
+//
+// A caller-owned flag that stops a running task: the families that call
+// throw_if_aborted() in their loops throw while the flag is non-zero, which the
+// C API reports as AUDIOCPP_ERR_RUNTIME. The flag is written by another thread
+// than the one that runs the task.
+
+#include <atomic>
+#include <cstdint>
+#include <stdexcept>
+
+namespace engine::runtime {
+
+inline std::atomic<const volatile int32_t *> g_abort_flag{nullptr};
+
+inline void throw_if_aborted() {
+    const volatile int32_t * flag = g_abort_flag.load(std::memory_order_relaxed);
+    if (flag != nullptr && *flag != 0) {
+        throw std::runtime_error("aborted");
+    }
+}
+
+}  // namespace engine::runtime
+
+#endif
