diff --git a/src/runtime/cli/without_tooling.rs b/src/runtime/cli/without_tooling.rs
new file mode 100644
index 00000000000..2f59fe93c05
--- /dev/null
+++ b/src/runtime/cli/without_tooling.rs
@@ -0,0 +1,180 @@
+//! `bun check`, `bun lint` and `bun fmt` in a Bun built without the `tooling` feature. The type checker, the linter and
+//! the formatter are left out (`bun_sema_driver`, `bun_lint_driver`, `bun_format_conformance`), and these modules stand
+//! in for `check_command.rs`, `lint_command.rs` and `format_command.rs`: the commands, and `--check` of
+//! `bun run`, `bun test` and `bun build`, say that they aren't in this build and fail.
+
+use bun_core::{Global, Output};
+
+/// Reports that `what` is left out of this build and exits.
+fn unavailable(what: &str) -> ! {
+    Output::err_generic(
+        "{} is not available in this build of Bun (built without the \"tooling\" feature)",
+        (what,),
+    );
+    Global::exit(1);
+}
+
+pub(crate) mod check_command {
+    use bun_bundler::options::TypeChecked;
+    use bun_clap as clap;
+    use bun_core::{Global, Output, ZStr};
+
+    pub(crate) type BeforeRead = Box<dyn Fn(&[u8]) + Send + Sync>;
+
+    pub(crate) struct CheckCommand;
+
+    pub(crate) const PARAMS: &[clap::Param<clap::Help>] = &[];
+
+    impl CheckCommand {
+        pub(crate) fn exec(_args: &[&ZStr]) -> ! {
+            super::unavailable("bun check")
+        }
+
+        pub(crate) fn exec_without_arguments() -> ! {
+            super::unavailable("bun check")
+        }
+    }
+
+    pub(crate) fn working_directory() -> Vec<u8> {
+        let mut buf = bun_paths::path_buffer_pool::get();
+        match bun_core::getcwd(&mut buf) {
+            Ok(cwd) => cwd.as_bytes().to_vec(),
+            Err(err) => {
+                Output::err(err, "Could not read the working directory", ());
+                Global::exit(1);
+            }
+        }
+    }
+
+    /// A file or snippet that's about to run. Never read here: there is no type checker to give it to.
+    #[allow(dead_code)]
+    #[derive(Clone, Copy)]
+    pub(crate) struct EntryPoint<'a> {
+        pub(crate) path: &'a [u8],
+        pub(crate) loader: Option<bun_ast::Loader>,
+        pub(crate) text: Option<&'a [u8]>,
+    }
+
+    impl<'a> EntryPoint<'a> {
+        pub(crate) fn file(path: &'a [u8]) -> EntryPoint<'a> {
+            EntryPoint {
+                path,
+                loader: None,
+                text: None,
+            }
+        }
+    }
+
+    const NO_CHECK: &str = "Type checking (--check) is not available in this build of Bun (built without the \"tooling\" feature)";
+
+    /// Fails: there is no type checker to run.
+    pub(crate) fn check_before(_entry_points: &[EntryPoint], _before_read: Option<BeforeRead>) -> bool {
+        Output::err_generic("{}", (NO_CHECK,));
+        false
+    }
+
+    pub(crate) fn watching(_vm: &bun_jsc::virtual_machine::VirtualMachine) -> Option<BeforeRead> {
+        None
+    }
+
+    pub(crate) fn check_for_build_command(_checked: TypeChecked, log: &mut bun_ast::Log) -> bool {
+        log.add_error(None, bun_ast::Loc::EMPTY, NO_CHECK);
+        false
+    }
+
+    pub(crate) fn check_for_bun_build(_checked: TypeChecked, log: &mut bun_ast::Log) -> bool {
+        log.add_error(None, bun_ast::Loc::EMPTY, NO_CHECK);
+        false
+    }
+
+    pub(crate) fn check_project_before(before_read: Option<BeforeRead>) -> bool {
+        check_before(&[], before_read)
+    }
+}
+
+pub(crate) mod lint_command {
+    use super::super::command::ContextData;
+    use bun_clap as clap;
+    use bun_core::ZStr;
+
+    /// `bun lint` isn't a command: it runs the project's own `lint`.
+    pub(crate) const IS_ENABLED: bool = false;
+
+    pub(crate) struct Group {
+        pub(crate) title: &'static str,
+        pub(crate) params: &'static [clap::Param<clap::Help>],
+    }
+
+    /// A command's flags, as `--help` lists them. There are none.
+    pub(crate) struct Help {
+        pub(crate) groups: &'static [Group],
+    }
+
+    impl Help {
+        pub(crate) fn common(&self) -> Vec<clap::Param<clap::Help>> {
+            Vec::new()
+        }
+    }
+
+    pub(crate) const HELP: Help = Help { groups: &[] };
+
+    pub(crate) struct LintCommand;
+
+    impl LintCommand {
+        pub(crate) fn has_flag(_flag: &[u8]) -> bool {
+            false
+        }
+
+        pub(crate) fn exec(_ctx: &mut ContextData, _args: &[&ZStr]) -> ! {
+            super::unavailable("bun lint")
+        }
+    }
+
+    /// `bun lint` starts no process that reads its program from stdin.
+    pub(crate) fn read_program_from_stdin(_ctx: &mut ContextData) {}
+}
+
+pub(crate) mod format_command {
+    use super::super::command::ContextData;
+    use bun_core::ZStr;
+
+    pub(crate) use super::lint_command::HELP;
+
+    pub(crate) struct FormatCommand;
+
+    impl FormatCommand {
+        pub(crate) fn has_flag(_flag: &[u8]) -> bool {
+            false
+        }
+
+        pub(crate) fn exec(_ctx: &mut ContextData, _args: &[&ZStr]) -> ! {
+            super::unavailable("bun fmt")
+        }
+    }
+}
+
+/// For src/jsc/bindings/LintHost.h (`lint_js.rs`). No file is ever being linted.
+#[repr(C)]
+pub(crate) struct LintSpan {
+    ptr: *const u8,
+    len: usize,
+}
+
+#[unsafe(no_mangle)]
+extern "C" fn Bun__Lint__ask(
+    _global: &bun_jsc::JSGlobalObject,
+    _kind: u32,
+    _details: *const u8,
+    _details_len: usize,
+) -> LintSpan {
+    LintSpan {
+        ptr: core::ptr::null(),
+        len: 0,
+    }
+}
+
+/// `process.versions.typescript`: none, since the type checker is left out.
+#[unsafe(no_mangle)]
+pub(crate) extern "C" fn Bun__typescript_version() -> *const core::ffi::c_char {
+    core::ptr::null()
+}
